{
  "name": "healthcalc-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:ui\"",
    "dev:ui": "vite --host",
    "dev:api": "cd server && node index.js",
    "start": "concurrently \"npm run dev:api\" \"npm run dev:ui\"",
    "build": "vite build",
    "preview": "vite preview",
    "validate": "node scripts/validate-data.mjs",
    "validate:baseline": "node scripts/check-validation-baseline.mjs",
    "validate:baseline:update": "node scripts/check-validation-baseline.mjs --update",
    "validate:nutrition": "node nutrition-validator.js",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "test:e2e": "playwright test",
    "test:kitchens": "esbuild scripts/test-multi-kitchen-generator.ts --bundle --platform=node --format=esm --target=node22 --external:@supabase/supabase-js --external:dotenv --log-level=warning --outfile=node_modules/.cache/kitchens-e2e.mjs && node node_modules/.cache/kitchens-e2e.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "dotenv": "^18.0.3",
    "lucide-react": "^1.41.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.20.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "husky": "^9.1.7",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.2.2",
    "vite": "^5.0.0"
  }
}
